                                                                                                                                                                                                                      \u2502\\n\u2502    94         }                                                                                                                                                                                                                                     \u2502\\n\u2502    95     }                                                                                                                                                                                                                                         \u2502\\n\u2502    96                                                                                                                                                                                                                                               \u2502\\n\u2502    97 ### CreateWorkers (/opt/HelloWorldApp/HelloWorldApp/WorkerFactory.cs):                                                                                                                                                                        \u2502\\n\u2502    98 public static IEnumerable<IWorker> CreateWorkers(INotifier notifier)                                                                                                                                                                          \u2502\\n\u2502    99         {                                                                                                                                                                                                                                     \u2502\\n\u2502   100             // create multiple workers, each knows how to call back                                                                                                                                         