                                                            \u2502\\n\u2502     9                                                                                                                                                                                                                                               \u2502\\n\u2502    10 ### WorkerA (/opt/HelloWorldApp/HelloWorldApp/WorkerA.cs):                                                                                                                                                                                    \u2502\\n\u2502    11 public class WorkerA : IWorker                                                                                                                                                                                                                \u2502\\n\u2502    12     {                                                                                                                                                                                                                                         \u2502\\n\u2502    13         private readonly INotifier _notifier;                                                                                                                                                                                                 \u2502\\n\u2502    14                                                                                                                                                                                                                                               \u2502\\n\u2502    15         public WorkerA(INotifier notifier)                                                                                                                                                                                                    \u2502\\n\u2502    16         {                                                                                         